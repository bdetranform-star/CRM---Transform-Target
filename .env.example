DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Neon's direct/unpooled connection string — required by Prisma Migrate
# (`migrate deploy`/`migrate dev`), which needs postgres advisory locks that
# Neon's pooled (PgBouncer) DATABASE_URL above doesn't reliably support. Not
# read by the app itself, only by the Prisma CLI. Same host/db as
# DATABASE_URL, just Neon's non-pooled connection string.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# INSTANTLY_API_KEY="your-instantly-ai-api-key"
# INSTANTLY_WEBHOOK_SECRET="a-shared-secret-you-also-configure-in-instantly"
# ANTHROPIC_API_KEY="your-anthropic-api-key" # required for the contact detail page's AI Insights + Ask a question chat
# BLOB_READ_WRITE_TOKEN="your-vercel-blob-token" # required for contact avatar photo uploads (connect a Vercel Blob store to the project, or run `vercel env pull` locally)
