// Prisma schema for Transform Targets CRM
// Datasource is PostgreSQL (e.g. Neon), since Vercel's filesystem is
// ephemeral and won't persist a SQLite file across deploys/instances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled (PgBouncer) connection in DATABASE_URL doesn't reliably
  // support the postgres advisory locks Prisma Migrate takes during
  // `migrate deploy`/`migrate dev`, which surfaces as a P1002 timeout on
  // Vercel builds. directUrl points Migrate at Neon's direct/unpooled
  // connection instead; the Prisma Client at runtime still uses the pooled
  // DATABASE_URL above.
  directUrl = env("DIRECT_URL")
}

/// A user who can log in to the CRM (NextAuth credentials provider).
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The 5 named team members. Used for both Contact.contactOwner and
/// Task.assignedTo — replaces the earlier 100 placeholder sending-account
/// emails, which represented outreach mailboxes rather than people.
enum TeamMember {
  SAAD_AHMED
  SHARMIN
  MUHAMMAD_NAUMAN
  SALMAN
  SHAHMIR
}

enum LeadStatus {
  NEW_LEAD
  OPEN_PROSPECT
  IN_PROCESS
  EMAIL_SENT
  CONNECTED
  OPEN_OPPORTUNITIES
  CURRENT_CUSTOMER
  CHURNED
  DEAD_LEAD
}

enum LifecycleStage {
  SUBSCRIBER
  LEAD
  MARKETING_QUALIFIED_LEAD
  SALES_QUALIFIED_LEAD
  OPPORTUNITY
  CUSTOMER
}

enum Industry {
  FACILITY_MAINTENANCE_COMPANIES
  INTEGRATED_FACILITY_MANAGEMENT
  MULTI_UNIT_RESTAURANT_FRANCHISE_GROUPS
  TRANSPORTATION_LOGISTICS
  CONSTRUCTION_COMPANIES
  HEALTHCARE_FACILITIES
}

/// Finer-grained vertical than Industry. Intentionally a flat list (not
/// filtered by Industry) per spec — a dropdown of every recognized niche.
enum IndustryDetail {
  HVAC
  ELECTRICAL
  PLUMBING
  ROOFING
  HANDYMAN
  JANITORIAL
  LANDSCAPING
  PEST_CONTROL
  SECURITY
  COMMERCIAL_OFFICES
  INDUSTRIAL_MANUFACTURING
  RETAIL_CHAINS
  EDUCATIONAL_CAMPUSES
  QSR_FAST_FOOD
  CASUAL_DINING
  MULTI_BRAND_OPERATOR
  FREIGHT_BROKERAGE_3PL
  ASSET_BASED_FLEET
  WAREHOUSING
  LAST_MILE_DELIVERY
  COMMERCIAL
  RESIDENTIAL
  INFRASTRUCTURE
  SPECIALTY_SUBCONTRACTOR
  URGENT_CARE_CHAINS
  HOSPITALS
  MULTI_SPECIALTY_CLINICS
  SENIOR_LIVING_FACILITIES
}

/// Which outreach channel/cadence sourced this lead (existing field).
enum LeadSource {
  COLD_EMAIL
  LINKEDIN
  COLD_CALL
  SMS
  WHATSAPP
  REFERRAL
  INBOUND
  EVENT
  OTHER
}

/// How the lead's contact data was originally sourced/scraped — distinct
/// from LeadSource, which is about the outreach channel, not data provenance.
enum LeadSourceCaptured {
  LINKEDIN_SALES_NAVIGATOR
  GOOGLE_MAPS
  GOOGLE_DORK
  ONLINE_DIRECTORY
}

enum Channel {
  EMAIL
  LINKEDIN
  CALL
  SMS
  NOTE
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

/// Where a LinkedIn connection request currently stands for this contact —
/// distinct from LinkedinLifecycleStage, which tracks the broader LinkedIn
/// outreach pipeline (a Kanban stage), not just the connection request itself.
enum LinkedinConnectionStatus {
  NOT_SENT
  REQUEST_SENT
  PENDING
  CONNECTED
  REJECTED
}

/// Pipeline stage for the LinkedIn-specific outreach Kanban board (separate
/// from the main Lead Board's LeadStatus) — powers /linkedin-lifecycle.
enum LinkedinLifecycleStage {
  NOT_CONTACTED
  CONNECTION_SENT
  CONNECTED
  FOLLOW_UP_IN_PROGRESS
  INTERESTED
  NOT_INTERESTED
}

/// Which channel a contact used to respond once interested, captured
/// separately from LeadSource (how they entered the CRM) and Touch.channel
/// (how a given outreach action was logged).
enum InterestedResponseChannel {
  EMAIL
  LINKEDIN
  CALLING
  TEXT
}

/// Free-form tagging of which outreach channel(s) have been used to reach a
/// contact — a contact can carry any combination (or none), unlike LeadSource
/// (a single "how this lead entered the CRM" value) or Touch.channel (one
/// value per logged action). Purely a manual, user-set label.
enum ChannelTag {
  EMAIL_CHANNEL
  LINKEDIN_CHANNEL
  COLD_CALLING_CHANNEL
  TEXT_WHATSAPP_CHANNEL
}

model Contact {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String?
  jobTitle       String?
  email          String   @unique
  workPhone      String?
  cellPhone      String?
  linkedinUrl    String?
  company        String?
  /// Person's title as tracked for outreach purposes — distinct from
  /// jobTitle, which is the CRM's own identity field; kept alongside
  /// `company` since that's where it's entered on the New Contact form.
  designation    String?
  /// Public URL of the uploaded photo (Vercel Blob). Null falls back to an
  /// initials circle everywhere the avatar is rendered.
  avatarUrl      String?

  lifecycleStage LifecycleStage @default(LEAD)
  leadStatus     LeadStatus     @default(NEW_LEAD)
  industry       Industry       @default(FACILITY_MAINTENANCE_COMPANIES)
  industryDetail IndustryDetail?
  contactOwner   TeamMember
  leadSource     LeadSource     @default(OTHER)
  /// How this lead's data was originally sourced/scraped (distinct from leadSource).
  leadSourceCaptured LeadSourceCaptured?
  /// Which outreach channel(s) have been used to reach this contact — a
  /// manually-set multi-select tag, independent of leadSource/leadStatus.
  /// Empty array (not null) when untagged, so it can always be spread/mapped
  /// without a null check.
  channelTags    ChannelTag[]   @default([])

  /// LinkedIn outreach tracking — all nullable since not every contact goes
  /// through a LinkedIn-specific cadence. `linkedinLifecycleStage` powers
  /// its own Kanban board (/linkedin-lifecycle), separate from the main
  /// Lead Board's `leadStatus`.
  linkedinConnectionStatus LinkedinConnectionStatus?
  linkedinPitchNote        String?                    @db.Text
  linkedinFollowUp1        Boolean?
  linkedinFollowUp2        Boolean?
  linkedinFollowUp3        Boolean?
  linkedinFollowUp4        Boolean?
  linkedinLifecycleStage   LinkedinLifecycleStage?
  interestedResponseFrom   InterestedResponseChannel?

  websiteUrl        String?
  websiteTraffic    Int?
  numberOfEmployees Int?
  streetAddress     String?
  city              String?
  state             String?
  country           String?
  zipCode           String?

  /// Most recent Touch with a positive/interested outcome (CONNECTED/REPLIED
  /// on any channel) — set automatically when such a Touch is logged.
  lastInterestedReply DateTime?
  /// Most recent Touch of any kind — set automatically on every Touch.
  lastContactDate     DateTime?

  /// Position in the 4-channel cadence: 0=Email 1, 1=LinkedIn touch, 2=Call, 3=SMS, 4+=repeat/breakup
  sequenceStep   Int      @default(0)
  smsOptOut      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Cached AI-generated summary for the contact detail page's Insights
  /// panel — regenerated only on manual "Regenerate" click, not on every
  /// page view, to control Anthropic API cost. Both fields are set together.
  aiInsightsSummary     String?   @db.Text
  aiInsightsGeneratedAt DateTime?

  touches      Touch[]
  deals        Deal[]
  tasks        Task[]
  chatMessages ContactChatMessage[]

  @@index([leadStatus])
  @@index([lifecycleStage])
  @@index([industry])
  @@index([contactOwner])
  @@index([sequenceStep])
  @@index([company])
  @@index([linkedinLifecycleStage])
}

enum ChatRole {
  USER
  ASSISTANT
}

/// Per-contact AI chat thread ("Ask a question" on the contact detail page's
/// Insights panel) — scoped to a single contact's properties + touch history,
/// persisted so it survives across visits to that contact's page.
model ContactChatMessage {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Touch {
  id        String    @id @default(uuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   Channel
  direction Direction
  /// e.g. CALL: CONNECTED / VOICEMAIL / NO_ANSWER / WRONG_NUMBER / CALLBACK_SCHEDULED
  /// SMS: SENT / DELIVERED / REPLIED / OPTED_OUT
  /// LINKEDIN: CONNECTION_SENT / CONNECTED / MESSAGE_SENT / REPLIED
  outcome   String?
  body      String?
  createdAt DateTime  @default(now())

  @@index([contactId])
  @@index([channel])
}

model SmsTemplate {
  id        String   @id @default(uuid())
  name      String
  /// Supports {{firstName}}, {{company}}, {{industryDetail}} tokens
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id        String    @id @default(uuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  value     Decimal?  @db.Decimal(12, 2)
  stage     DealStage @default(NEW)
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([contactId])
  @@index([stage])
}

model Task {
  id         String     @id @default(uuid())
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  dueDate    DateTime?
  completed  Boolean    @default(false)
  assignedTo TeamMember
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([contactId])
  @@index([completed])
  @@index([assignedTo])
}
